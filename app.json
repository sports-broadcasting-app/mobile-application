{
  "expo": {
    "name": "Onde Passa",
    "slug": "where-to-watch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "where-to-watch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.diego-serrat.wheretowatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.diego_serrat.wheretowatch"
    },
    "updates": {
      "url": "https://u.expo.dev/d6b5c58b-a580-4329-8332-30a9f2767eaf"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d6b5c58b-a580-4329-8332-30a9f2767eaf"
      }
    },
    "plugins": [
      "expo-image",
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-6788179394340056~1235566675",
          "androidAppId": "ca-app-pub-6788179394340056~2613207469",
          "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Usamos esse identificador para mostrar anúncios mais relevantes para você."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#16a34a"
        }
      ]
    ]
  }
}
