{
  "expo": {
    "name": "where-to-watch",
    "slug": "where-to-watch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "where-to-watch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diego-serrat.wheretowatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icon-ios-light.png",
        "dark": "./assets/icon-ios-dark.png",
        "tinted": "./assets/icon-ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.diego_serrat.wheretowatch"
    },
    "updates": {
      "url": "https://u.expo.dev/d6b5c58b-a580-4329-8332-30a9f2767eaf"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d6b5c58b-a580-4329-8332-30a9f2767eaf"
      }
    },
    "plugins": [
      "expo-image",
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ]
    ]
  }
}
